# ===== Database (PostgreSQL) =====
PGHOST=localhost
PGPORT=5432
PGDATABASE=odgj_street_coffee
PGUSER=postgres
PGPASSWORD=postgres

# ===== Server =====
PORT=3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=ganti-dengan-rahasia-panjang-32-karakter

# ===== Midtrans (sandbox) =====
MIDTRANS_SERVER_KEY=SB-Mid-server-xxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxx
MIDTRANS_IS_PRODUCTION=false

# ===== Cache (opsional — kosongkan untuk memory fallback) =====
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# ===== Pembayaran =====
